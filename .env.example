DEBUG=False

DJANGO_SECRET_KEY=replace-with-a-long-random-secret

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Private URL segment for /portfolio-admin/<code>/  -> choose your own, do NOT keep the example
PORTFOLIO_ADMIN_CODE=change-me-to-something-private

# Admin login (used by `createsuperuser --noinput` in build.sh)
DJANGO_SUPERUSER_USERNAME=your-admin-username
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=a-long-unique-password

# Optional: keep the database and uploads on a persistent disk
# SQLITE_PATH=/var/data/db.sqlite3
# MEDIA_ROOT=/var/data/media
